{
  "name": "disposable-email-domains-js",
  "version": "2.4.0",
  "description": "Determine whether an email address or domain is disposable.",
  "keywords": [
    "disposable",
    "email",
    "domain",
    "blocklist",
    "temporary-email"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.esm.json",
    "lint": "prettier --check . && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.esm.json --noEmit",
    "lint:fix": "prettier --write .",
    "prepare": "npm run build",
    "postbuild": "ts-node bin/postbuild.ts",
    "test": "npm run test:jest && npm run test:example",
    "test:jest": "jest --coverage --reporters=jest-junit",
    "test:example": "cd example && npm install && npm run test",
    "generate:disposable_email_blocklist_json": "ts-node bin/generate_disposable_email_blocklist.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mziyut/disposable-email-domains-js.git"
  },
  "author": "Yuta Mizui <mziyut.dev@gmail.com>",
  "license": "CC0-1.0",
  "bugs": {
    "url": "https://github.com/mziyut/disposable-email-domains-js/issues"
  },
  "homepage": "https://github.com/mziyut/disposable-email-domains-js#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.1",
    "jest": "^30.0.4",
    "jest-junit": "^17.0.0",
    "prettier": "3.10.1",
    "prettier-plugin-organize-imports": "^4.2.0",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "volta": {
    "node": "26.13.1"
  }
}
